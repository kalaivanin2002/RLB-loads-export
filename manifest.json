{
  "manifest_version": 3,
  "name": "RLB Load Search",
  "version": "1.1.0",
  "description": "Highlights Amazon Relay load board results that match your available drivers.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RLB Load Search",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["scripting", "tabs", "storage", "unlimitedStorage"],
  "host_permissions": [
    "https://relay.amazon.co.uk/*",
    "https://relay.amazon.com/*",
    "https://afp-api.fleetyes.com/*",
    "https://rsp-api.fleetyes.com/*",
    "https://nominatim.openstreetmap.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://relay.amazon.co.uk/*", "https://relay.amazon.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://relay.amazon.co.uk/*", "https://relay.amazon.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    },
    {
      "matches": ["https://relay.amazon.co.uk/*", "https://relay.amazon.com/*"],
      "js": ["loadboard.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}

{
  "manifest_version": 3,
  "name": "RLB Load Search",
  "version": "1.1.0",
  "description": "Amazon Relay load board helper: harvest RLB city locations and search loads via the Relay UI.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "RLB Load Search"
  },
  "permissions": ["scripting", "tabs", "storage", "unlimitedStorage"],
  "host_permissions": [
    "https://relay.amazon.co.uk/*",
    "https://relay.amazon.com/*",
    "https://ontrack-api.agilecyber.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}

{
  "manifest_version": 3,
  "name": "RLB Load Search",
  "version": "1.1.0",
  "description": "Amazon Relay load board helper: search loads per driver, and harvest RLB city locations into the OnTrack API.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "RLB Load Search"
  },
  "permissions": ["scripting", "tabs", "storage", "unlimitedStorage", "alarms"],
  "host_permissions": [
    "https://relay.amazon.co.uk/*",
    "https://relay.amazon.com/*",
    "https://ontrack-api.agilecyber.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://relay.amazon.co.uk/*", "https://relay.amazon.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://relay.amazon.co.uk/*", "https://relay.amazon.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ],
  "web_accessible_resources": []
}
